<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Verification Code - Scholars Press</title>
    <style>
      /* Reset */
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        background: #f9fafb;
        line-height: 1.6;
        color: #1f2937;
      }

      /* Reset Button */
      .reset-btn {
        display: inline-block;
        margin: 20px 0;
        padding: 14px 28px;
        background: linear-gradient(135deg, #f97316, #f59e0b);
        color: #ffffff !important;
        font-weight: bold;
        border-radius: 8px;
        font-size: 16px;
      }
      .reset-btn:hover {
        opacity: 0.9;
      }
      .reset-link {
        font-size: 14px;
        color: #f97316;
        word-break: break-all;
      }
      a {
        color: inherit;
        text-decoration: none;
      }

      /* Container */
      .email-container {
        max-width: 600px;
        margin: 20px auto;
        background: #fff;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
      }

      /* Header */
      .email-header {
        background: linear-gradient(135deg, #f97316, #f59e0b);
        padding: 40px 30px;
        text-align: center;
        color: #fff;
      }
      .email-header .logo {
        width: 60px;
        height: 60px;
        margin: 0 auto 20px;
        border-radius: 50%;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .email-header .logo img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      .email-header h2 {
        font-size: 26px;
        margin-bottom: 5px;
      }
      .email-header p {
        font-size: 16px;
      }

      /* Body */
      .email-body {
        padding: 40px 30px;
        text-align: center;
      }
      .email-body p {
        font-size: 16px;
        margin-bottom: 20px;
      }
      .code-box {
        background: #fff7ed;
        border: 2px dashed #f59e0b;
        border-radius: 12px;
        padding: 25px 0;
        margin: 30px auto;
        width: 80%;
        max-width: 300px;
      }
      .code {
        font-size: 36px;
        letter-spacing: 6px;
        font-weight: bold;
        color: #f97316;
      }

      /* Warning */
      .warning {
        background: #fee2e2;
        border-left: 4px solid #dc2626;
        padding: 15px;
        border-radius: 8px;
        font-size: 14px;
        color: #991b1b;
        margin-top: 20px;
        text-align: left;
      }

      /* Footer */
      .email-footer {
        background: #1f2937;
        padding: 25px 20px;
        text-align: center;
        color: #9ca3af;
        font-size: 13px;
      }
      .email-footer .highlight {
        color: #f59e0b;
      }

      /* Mobile */
      @media only screen and (max-width: 600px) {
        .email-body {
          padding: 30px 20px;
        }
        .email-header {
          padding: 30px 20px;
        }
        .code {
          font-size: 28px;
          letter-spacing: 4px;
        }
      }
    </style>
  </head>
  <body>
    <div class="email-container">
      <!-- Header -->
      <div class="email-header">
        <div class="logo">
          <img
            src="https://scholarspress.com/assets/piclog.png"
            alt="Scholars Press"
          />
        </div>
        <h2>Verification Code</h2>
        <p>Scholars Press Security Center</p>
      </div>

      <!-- Body -->
      <div class="email-body">
        <p>Hello <%= userName || "Valued Member" %>,</p>
        <p>
          Use the code below to reset your password. This code will expire
          shortly.
        </p>

        <div class="code-box">
          <div class="code"><%= code %></div>
        </div>

        <p>
          Do not share this code with anyone. It is only for your account
          verification.
        </p>

        <a
          href="http://localhost:5173/auth/reset-password?email=<%= email %>&code=<%= code %>"
          class="reset-btn"
        >
          Reset Your Password
        </a>

        <p style="margin-top: 10px; font-size: 14px">
          If the button doesn’t work, copy and paste this link into your
          browser:
        </p>

        <p class="reset-link">
          http://localhost:5173/auth/reset-password?email=<%= email %>&code=<%=
          code %>
        </p>

        <div class="warning">
          ⚠️ If you didn’t request this code, please ignore this email or
          contact support immediately.
        </div>
      </div>

      <!-- Footer -->
      <div class="email-footer">
        <div><span class="highlight">Scholars</span> Press</div>
        <p style="margin-top: 5px">
          Excellence in Research & Academic Publishing
        </p>
        <p style="margin-top: 10px; font-size: 12px; color: #6b7280">
          © 2025 Scholars Press — All rights reserved
        </p>
      </div>
    </div>
  </body>
</html>
